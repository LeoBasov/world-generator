        },
        "max": {
          "description": "Upper end b of the field range.",
          "type": "number", "minimum": -1000, "maximum": 1000, "default": 100,
          "x-df-name": "{FIELD}", "x-unit": "field", "x-report": "R3.3"
        },
        "weights": {
          "description": "Relative weights of the five bins of [min, max]; only ratios matter.",
