        },
        "x_variance": {
          "description": "X-variance V_x of the midpoint displacement.",
          "type": "number", "minimum": 0, "maximum": 3200, "default": 800,
          "x-df-name": "{FIELD}", "x-unit": "", "x-report": "R3.4"
        },
        "y_variance": {
          "description": "Y-variance V_y of the midpoint displacement.",
          "type": "number", "minimum": 0, "maximum": 3200, "default": 800,
          "x-df-name": "{FIELD}", "x-unit": "", "x-report": "R3.4"
        },
        "hurst": {
          "description": "Hurst exponent H of the displacement decay sigma_k = sigma_0 2^(-kH).",
          "type": "number", "minimum": 0.01, "maximum": 0.99, "default": 0.5,
