          "items": { "type": "number", "minimum": 0, "maximum": 1000000 },
          "x-df-name": "{FIELD}_FREQUENCY", "x-unit": "", "x-report": "R3.2"
        },
        "mesh": {
          "description": "Mesh parameter m: control grid of 2^(m-1) cells per axis (1 = mesh ignored).",
          "type": "integer", "minimum": 1, "maximum": 6, "default": 3,
