{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeoBasov/world-generator/schema/rock_types.schema.json",
  "title": "worldgen-core rock types",
  "description": "Layer stones of the stone column (R10.1, A21, A25). The erodibility values are uncalibrated defaults, tuned in A25 and A29.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rocks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "rocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "class",
          "aquifer",
          "shallow_ocean",
          "deep_ocean",
          "erodibility",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "class": {
            "enum": [
              "sedimentary",
              "igneous_extrusive",
              "igneous_intrusive",
              "metamorphic"
            ]
          },
          "aquifer": {
            "description": "The layer can hold an aquifer (R10.3).",
            "type": "boolean"
          },
          "shallow_ocean": {
            "description": "Allowed under shallow ocean.",
            "type": "boolean"
          },
          "deep_ocean": {
            "description": "Allowed under deep ocean.",
            "type": "boolean"
          },
          "erodibility": {
            "description": "Stream-power erodibility K [m^(1-2m)/yr] for m = 0.5.",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.01
          },
          "confidence": {
            "description": "Evidence level (report section 1): documented, observed or unverified.",
            "enum": [
              "documented",
              "observed",
              "unverified"
            ]
          }
        }
      }
    }
  }
}
